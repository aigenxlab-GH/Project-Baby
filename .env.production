# Build-time public configuration for production builds.
#
# WHY THIS FILE EXISTS
# NEXT_PUBLIC_* values are inlined when `next build` runs, so they must be
# present at BUILD time. They were only ever set in the GitHub Actions step env,
# which was not reaching the build inside `@opennextjs/cloudflare build`. The
# result: every statically prerendered page (blog, products, tools, homepage)
# rendered with NO ad units at all, while pages still rendered on demand by the
# Worker picked the values up at request time from wrangler.toml [vars] and did
# show ads. That inconsistency hid the bug for a long time.
#
# Next.js loads .env.production automatically for production builds, so keeping
# these here removes the dependency on CI env plumbing entirely.
#
# SAFE TO COMMIT: these are public identifiers. The publisher ID and slot IDs
# are served in the HTML of every page and visible in page source. Nothing here
# is a secret — real secrets (API tokens) stay in GitHub Secrets and are never
# NEXT_PUBLIC_*.

NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-9203095207294518
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=1378297902
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=8027761881
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=7889036797
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=5125971221
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=1186726216

# Sanity project identifiers are public too (they appear in image CDN URLs).
NEXT_PUBLIC_SANITY_PROJECT_ID=mnwolxvz
NEXT_PUBLIC_SANITY_DATASET=production
